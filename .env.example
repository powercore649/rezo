# ─────────────────────────────────────────────────────────────────────────────
# REZO — modèle d'environnement. Copier en `.env` puis remplir.
#   cp .env.example .env
#
# `.env` n'est jamais commité (voir .gitignore). Tout est optionnel sauf les
# deux lignes marquées OBLIGATOIRE : le noyau refuse de démarrer sans elles
# (core/kernel.js → validateEnv). Les autres variables désactivent proprement
# la fonctionnalité correspondante au lieu de planter.
# ─────────────────────────────────────────────────────────────────────────────

# ── OBLIGATOIRE ──────────────────────────────────────────────────────────────
# Jeton du bot : Discord Developer Portal → Bot → Reset Token.
TOKEN=
# Chaîne de connexion MongoDB (locale ou Atlas).
MONGODB_URI=

# ── Identité & owners ───────────────────────────────────────────────────────
# IDs Discord séparés par des virgules : accès aux commandes /license, /blacklist…
OWNER_IDS=
# Application (client) ID — utilisée pour construire les liens d'invitation.
DISCORD_CLIENT_ID=
# Serveur de test : les copies locales des commandes y sont retirées au démarrage.
DEV_GUILD_ID=
# Lien d'invitation affiché par /botinfo et /help.
INVITE_URL=
# Nom de l'hébergeur affiché dans /botinfo (facultatif).
HOSTING_LABEL=
# Salon de journalisation globale (facultatif).
LOG_CHANNEL_ID=

# ── Sharding ────────────────────────────────────────────────────────────────
# Nombre de shards du ShardingManager. Laisser vide = automatique.
SHARD_COUNT=

# ── MongoDB — tenue en charge (voir BASE_DE_DONNEES.md) ─────────────────────
# Connexions par processus : en mode shardé, N shards × 100 saturent la base.
MONGO_MAX_POOL=
# Temps maximal pour joindre la base (ms).
MONGO_SERVER_SELECTION_MS=15000
# Délai de connexion initiale (ms).
MONGO_CONNECT_TIMEOUT_MS=15000
# Inactivité maximale d'un socket (ms).
MONGO_SOCKET_TIMEOUT_MS=45000
# Fermeture des connexions inutilisées (ms).
MONGO_MAX_IDLE_MS=120000
# Au-delà, une requête en attente échoue vite au lieu de s'empiler (ms).
MONGO_WAIT_QUEUE_MS=10000
# false = index construits par l'entretien nocturne, pas à chaque démarrage.
MONGO_AUTO_INDEX=true

# ── Caches de configuration par serveur ─────────────────────────────────────
DB_CACHE_TTL=60000
DB_CACHE_NEG_TTL=300000
DB_CACHE_MAX=20000
DB_CACHE_TIMEOUT=2500

# ── Journalisation ──────────────────────────────────────────────────────────
# debug | info | warn | error | silent (défaut : info, debug en développement).
LOG_LEVEL=
NODE_ENV=production
# 1 = pas de couleurs ANSI dans les logs.
NO_COLOR=

# ── Visuels (cartes canvas) ─────────────────────────────────────────────────
# 0 = aucune image générée : le binaire natif n'est même pas chargé, donc il ne
# peut pas faire tomber le bot. Toutes les commandes restent disponibles.
MEDIA_CARDS=1
# Ancien nom de MEDIA_CARDS, encore accepté.
MUSIC_CARD=
# 0 = pas de carte de lecture dans la musique.
RADIO_CARD=1
# Intervalle minimal entre deux cartes radio (ms).
RADIO_CARD_MS=
# Redémarrages du flux radio, séparés par des virgules (ms).
RADIO_RECONNECT_DELAYS_MS=
# Bannière d'accueil du /help.
HELP_BANNER_URL=

# ── IA (Gemini) ─────────────────────────────────────────────────────────────
# Clé Google AI Studio. Sans elle, /ia répond que la fonctionnalité est
# indisponible au lieu de planter.
GEMINI_API_KEY=
AI_IMAGE_MODEL=
AI_IMAGE_ENDPOINT=
AI_IMAGE_TIMEOUT_MS=
AI_IMAGE_INTERVAL_MS=
AI_CREATOR_ID=
AI_CREATOR=
AI_CREATOR_DISPLAY=
# Repli d'images (Pollinations), facultatif.
POLLINATIONS_API_KEY=
POLLINATIONS_TOKEN=

# ── Musique ─────────────────────────────────────────────────────────────────
# Dossier des binaires yt-dlp / ffmpeg (voir `npm run music:setup`).
MUSIC_BIN_DIR=
YTDLP_DOWNLOAD_URL=
FFMPEG_DOWNLOAD_URL=

# ── Anti-VPN (portail de vérification) ──────────────────────────────────────
# Sans ANTIVPN_PORT ni ANTIVPN_PUBLIC_URL, le portail ne démarre pas.
ANTIVPN_PORT=
ANTIVPN_HOST=
ANTIVPN_PUBLIC_URL=
# 1 si un proxy TLS (tunnel) est devant le portail.
ANTIVPN_TRUST_PROXY=
# auto (défaut) | off
ANTIVPN_TUNNEL=
# Binaire cloudflared (sinon téléchargé dans tools/).
CLOUDFLARED_PATH=
# Jeton d'API du service de détection, si tu en utilises un.
ANTIVPN_API_KEY=

# ── Site marchand / licences (voir SITE.md) ─────────────────────────────────
STORE_PORT=
STORE_HOST=
SITE_URL=
STORE_PUBLIC_URL=
STORE_TRUST_PROXY=
STORE_ADMIN_TOKEN=
STORE_MAIL_FROM=
STORE_MAIL_REPLY_TO=
STORE_MAIL_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
BREVO_API_KEY=
SITE_PRICE_EVENT_CENTS=
SITE_PRICE_PRO_CENTS=
SITE_PRICE_BUSINESS_CENTS=
SITE_PRICE_NETWORK_CENTS=
SITE_PRICE_LIFETIME_CENTS=
# Packs tout compris (licence + prestations), vendus sur /packs.
SITE_PRICE_PACK_DECOUVREUR_CENTS=
SITE_PRICE_PACK_LANCEMENT_CENTS=
SITE_PRICE_PACK_PREMIER_REZO_CENTS=
SITE_PRICE_PACK_COMMUNAUTE_CENTS=
SITE_PRICE_PACK_RESEAU_CENTS=
SITE_PRICE_PACK_INTEGRAL_CENTS=
# Destinataire des demandes de devis (formulaire /devis).
# Valeur par défaut si vide : raphwieczorek@gmail.com
STORE_QUOTE_TO=

# ── Licences — valeurs par défaut ───────────────────────────────────────────
LICENSE_DAYS=30
LICENSE_PRICE_COINS=
TRIAL_ENABLED=
TRIAL_DURATION_DAYS=
TRIAL_MIN_AGE_DAYS=
TRIAL_MIN_MEMBERS=

# ── Intégrations tierces (facultatives) ─────────────────────────────────────
# /reddit-annonce — sans ces deux valeurs, la commande est indisponible.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Alertes Twitch.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Alertes YouTube (/youtube-sub).
YOUTUBE_API_KEY=
# /meteo.
WEATHER_KEY=

# ── Secrets internes ────────────────────────────────────────────────────────
# Clé de chiffrement des profils 2FA (/authentificator). À conserver : la
# changer rend les profils existants illisibles.
AUTH_ENCRYPTION_KEY=
# Signature des confessions anonymes.
CONFESSION_SECRET=
