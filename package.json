    "test:auth": "node tests/authentificator-smoke.js",
    "test:v2": "node tests/v2-core.js",
    "test:features": "node tests/new-features-smoke.js",
    "test:boost": "node tests/boost-smoke.js",
    "test:bump": "node tests/bump-smoke.js",
    "test:invites": "node tests/invite-system-smoke.js",
    "test:ai": "node tests/ai-command-knowledge.js && node tests/ai-chat-flow.js",
    "test:captcha": "node tests/captcha-smoke.js",
    "test:antinuke": "node tests/antinuke-smoke.js",
    "test:join": "node tests/join-guard-smoke.js",
    "test:antivpn": "node tests/anti-vpn-smoke.js",
    "test:custom": "node tests/custom-commands-smoke.js",
    "test:welcomecard": "node tests/welcome-card-custom-smoke.js",
    "test:levelupcard": "node tests/levelup-card-smoke.js",
    "test:tresor": "node tests/treasure-smoke.js",
    "test:vault": "node tests/permission-vault-smoke.js",
    "test:help": "node tests/help-smoke.js && node tests/help-center-smoke.js",
    "test:birthday": "node tests/birthday-smoke.js",
    "test:music": "node tests/music-smoke.js",
    "test:site": "node tests/site-status-smoke.js",
    "test:shards": "node tests/sharding-smoke.js",
    "test:db": "node tests/db-maintenance-smoke.js",
    "test:scale": "node tests/scale-smoke.js",
    "test:shop": "node tests/shop-smoke.js",
    "test:map": "node tests/map-smoke.js",
    "test:botinfo": "node tests/botinfo-smoke.js",
    "music:setup": "node scripts/install-media-tools.js",
    "music:check": "node scripts/install-media-tools.js --check",
    "lavalink:check": "node scripts/lavalink-probe.js",
    "site": "node scripts/store-server.js",
    "emojis:import": "node scripts/import-emojis.js",
    "emojis:check": "node scripts/import-emojis.js --dry-run",
