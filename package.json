  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^2.17.1",
    "@napi-rs/canvas": "^1.0.11",
    "axios": "^1.18.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "jimp": "^0.22.10",
    "libsodium-wrappers": "^0.8.4",
    "mongoose": "^8.4.1",
    "nanoid": "^3.3.7",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "opusscript": "^0.1.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.3",
    "tesseract.js": "^5.1.1"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/win32-x64": "^4.1.0",
    "@napi-rs/canvas-win32-x64-msvc": "^1.1.0"
