{
  "name": "rezo",
  "version": "2.1.0",
  "private": true,
  "license": "MIT",
  "author": "REZO",
  "description": "REZO — bot Discord tout-en-un auto-hébergeable (modération, réseau, boutique, licences)",
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "moderation",
